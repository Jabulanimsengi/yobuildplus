// Yobuildplus Database Schema
// PostgreSQL database for builder/contractor directory

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODELS (Authentication)
// ============================================

enum Role {
  admin
  contractor
  client
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(client)
  
  builderId String?  @unique
  builder   Builder? @relation(fields: [builderId], references: [id])
  
  notifications     Notification[]
  quoteRequests     QuoteRequest[]
  savedContractors  SavedContractor[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model SavedContractor {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, builderId])
  @@index([userId])
}


// ============================================
// CATEGORY MODELS
// ============================================

model Category {
  id            String        @id @default(uuid())
  slug          String        @unique
  name          String
  icon          String
  description   String
  subcategories Subcategory[]
  builders      Builder[]     @relation("BuilderCategories")
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  searchTerms String[]
  
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  builders    Builder[] @relation("BuilderSubcategories")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// BUILDER MODELS
// ============================================

model Builder {
  id                String        @id @default(uuid())
  slug              String        @unique
  name              String
  logo              String?
  coverImage        String?
  description       String
  yearStarted       Int
  teamSize          Int
  projectsCompleted Int
  city              String
  address           String
  phone             String
  email             String
  website           String?
  rating            Float         @default(0)
  reviewCount       Int           @default(0)
  verified          Boolean       @default(false)
  serviceAttributes String[]
  photos            String[]
  provinces         String[]
  latitude          Float?
  longitude         Float?
  
  // New fields for pricing and areas
  callOutFee        Float?
  hourlyRate        Float?
  serviceAreas      String[]
  
  // Operating hours - JSON with daily schedule
  // Format: { monday: { open: "08:00", close: "17:00", closed: false }, ... }
  operatingHours    Json?
  
  // Approval workflow
  approvalStatus    String        @default("pending") // pending, approved, rejected
  
  // Subscription & Commission
  subscriptionPlan  String        @default("free") // "free" | "pro"
  subscriptionStatus String       @default("active") // active, cancelled, expired
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  commissionRate    Float         @default(0.25) // 25% for free tier, 0% for pro
  
  categories    Category[]    @relation("BuilderCategories")
  subcategories Subcategory[] @relation("BuilderSubcategories")
  projects      Project[]
  reviews       Review[]
  quotes        QuoteRequest[]
  savedBy       SavedContractor[]
  user          User?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([rating])
  @@index([verified])
  @@index([approvalStatus])
  @@index([subscriptionPlan])
}

// ============================================
// PROJECT & REVIEW MODELS
// ============================================

model Project {
  id          String    @id @default(uuid())
  title       String
  description String
  status      String    // ongoing, completed, cancelled
  images      String[]
  province    String
  city        String
  completedAt DateTime?
  
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  builderId String
  
  // Link to accepted quote
  quoteId   String?   @unique
  quote     QuoteRequest? @relation(fields: [quoteId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([quoteId])
}

model Review {
  id           String   @id @default(uuid())
  authorName   String
  authorAvatar String?
  rating       Int
  comment      String
  projectType  String?
  
  builder   Builder @relation(fields: [builderId], references: [id], onDelete: Cascade)
  builderId String
  
  createdAt DateTime @default(now())

  @@index([builderId])
  @@index([rating])
}

model QuoteRequest {
  id          String   @id @default(uuid())
  builderId   String
  builder     Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  // Consumer Details
  name        String
  email       String
  phone       String
  location    String?
  
  // Project Details
  title       String?   // Quote title for tracking
  message     String
  
  // Status Flow:
  // quote_requested -> request_accepted/request_rejected/request_considering
  // request_accepted -> quoted -> quote_accepted/quote_rejected/counter_proposal
  // quote_accepted -> project_created -> completed
  status      String   @default("quote_requested")
  
  // Quotation Response (filled by builder)
  totalAmount     Float?
  currency        String?   @default("ZAR")
  validUntil      DateTime?
  notes           String?
  respondedAt     DateTime?
  
  // Counter-proposal from consumer
  proposedAmount  Float?
  proposalNotes   String?
  
  // For counter-proposal linking
  parentQuoteId   String?
  parentQuote     QuoteRequest? @relation("CounterProposals", fields: [parentQuoteId], references: [id])
  counterProposals QuoteRequest[] @relation("CounterProposals")
  
  // Consumer user tracking
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  
  items           QuotationItem[]
  notifications   Notification[]
  project         Project?
  payments        Payment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([builderId])
  @@index([status])
  @@index([userId])
  @@index([parentQuoteId])
}

model QuotationItem {
  id          String        @id @default(uuid())
  description String
  quantity    Float
  unitPrice   Float
  unit        String?       // e.g., "hours", "sqm", "each"
  totalPrice  Float
  
  quoteId     String
  quote       QuoteRequest  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime      @default(now())
  
  @@index([quoteId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // quote_request, quote_response, quote_accepted, quote_rejected
  title     String
  message   String
  read      Boolean  @default(false)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  quoteId   String?
  quote     QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
  
  @@index([userId, read])
  @@index([createdAt])
}

// ============================================
// PAYMENT & ESCROW MODELS
// ============================================

model Payment {
  id              String    @id @default(uuid())
  quoteId         String
  quote           QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  amount          Float     // Total payment amount
  platformFee     Float     @default(0) // Commission amount
  netAmount       Float     // Amount to contractor after fees
  
  status          String    @default("pending") // pending, held, released, refunded, disputed
  
  // Payment tracking
  paidByClientAt  DateTime?
  heldAt          DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  
  // Milestone info (optional)
  milestoneNumber Int?
  milestoneDesc   String?
  
  // Payment reference
  paymentRef      String?
  paymentMethod   String?   // eft, card, etc.
  
  notes           String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([quoteId])
  @@index([status])
}
